{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/check-balance.ts",
    "src/cli.ts",
    "src/contract.ts",
    "src/deploy.ts",
    "src/network.ts",
    "src/setup.ts",
    "src/wallet-state.ts",
    "src/wallet.ts"
  ],
  "exclude": ["node_modules", "dist", "contracts/managed"]
}
